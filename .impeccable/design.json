      "css": ".ds-dock{display:flex;align-items:center;width:min(calc(100% - 48px),346px);height:62px;padding:7px 9px;border-radius:32px;background:var(--surface,#fffdf8);box-shadow:0 6px 28px #302e2917,0 1px 4px #302e2910}.ds-dock button{display:flex;align-items:center;justify-content:center;min-height:48px;border:0;background:none;color:var(--ink,#302e29);font:400 13px Inter,sans-serif;cursor:pointer;border-radius:24px}.ds-chapter{flex:1;gap:10px;padding:0 13px}.ds-chapter svg{margin-left:auto}.ds-dock .ds-notes{min-width:67px;color:var(--accent,#53634f);font-size:12px}.ds-text{width:48px;font-size:20px!important}.ds-divider{height:22px;width:1px;background:var(--line,#ded8cd);margin:0 7px}.ds-dock button:active{background:var(--accent-wash,#e8ecdf)}@media(hover:hover) and (pointer:fine){.ds-dock button:hover{background:var(--accent-wash,#e8ecdf)}}.ds-dock button:focus-visible{outline:2px solid var(--accent,#53634f);outline-offset:4px;border-radius:4px}"
