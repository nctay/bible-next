  "narrative": {
    "northStar": "Modern warm book",
    "overview": "This is descriptive implementation language, not a chosen product name. The confirmed direction is a modern book: warm light paper, dark serif reading, subtle underlined phrases and an expandable bottom sheet. A continuous reading column remains the main surface; controls stay compact and quiet.\n\nThe recorded system describes the shipped local mobile pilot. Evidence: `src/styles.css`, `src/App.tsx`, `src/main.tsx`, `public/icon.svg`, and the mobile and expanded-sheet screenshots in `.impeccable/review/`. No approved comp or external fidelity claim exists.",
    "keyCharacteristics": [
      "Warm tonal surfaces with a restrained sage accent.",
      "Lora reading and headings; Inter controls and metadata.",
      "Fine phrase underlines and border-separated supporting rows.",
      "A floating reading dock and two-height bottom sheet."
    ],
    "rules": [
      {
        "name": "The Reading Ink Rule",
        "body": "Annotated phrases retain the reading text's color; their underline carries the affordance, with sage wash on interaction.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep Scripture, note summaries and editorial titles in Lora; use Inter for navigation, controls, sources and metadata.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the warm paper and dark reading ink roles.",
      "**Do** use Lora for reading and Inter for controls and metadata.",
      "**Do** preserve visible focus, explicit sheet controls and reduced-motion support.",
      "**Do** reserve bottom space and safe-area offsets for the floating controls."
    ],
    "donts": [
      "**Don't** turn the mobile pilot into a wider dashboard on large screens.",
      "**Don't** replace subtle phrase underlines with filled buttons inside Scripture.",
      "**Don't** present draft badges or source attribution as decorative promotional elements."
    ]
  }
}
