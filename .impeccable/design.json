      "css": ".ds-reading{font:400 21px/1.85 Lora,Georgia,serif;color:var(--ink,#302e29)}.ds-phrase{display:inline;font:inherit;text-align:inherit;color:inherit;background:none;border:0;padding:5px 0;margin:-5px 0;border-radius:3px;text-decoration:underline;text-decoration-color:#8c9a79;text-decoration-thickness:1px;text-underline-offset:5px;text-decoration-skip-ink:auto;user-select:text;cursor:pointer;transition:background-color 140ms ease,text-decoration-color 140ms ease}.ds-phrase:active{background:var(--accent-wash,#e8ecdf);text-decoration-color:var(--accent,#53634f)}@media(hover:hover) and (pointer:fine){.ds-phrase:hover{background:var(--accent-wash,#e8ecdf);text-decoration-color:var(--accent,#53634f)}}.ds-phrase:focus-visible{outline:2px solid var(--accent,#53634f);outline-offset:4px;border-radius:4px}@media(prefers-reduced-motion:reduce){.ds-phrase{transition-duration:.01ms}}"
